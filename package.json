{
  "name": "sparepart-monitoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monitoring Sparepart Gudang - PT. Gorontalo Panel Lestari (Cloudflare Pages + Neon + R2)",
  "scripts": {
    "css": "tailwindcss -i src/styles.css -o public/assets/app.css --minify",
    "css:watch": "tailwindcss -i src/styles.css -o public/assets/app.css --watch",
    "build": "npm run css",
    "dev": "npm run css && wrangler pages dev public",
    "deploy": "npm run build && wrangler pages deploy public --project-name sparepart-monitoring",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:force": "node scripts/seed.mjs --force",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.0.0"
  },
  "engines": { "node": ">=20" }
}
